#USD:modify for Third-party electricity meter by zhenglong.hong 20260411 start
service fuelgauged /vendor/bin/fuelgauged
    class core
    user system
    group system
    disabled

on boot && property:ro.vendor.fuelgauged.disable=0
    start fuelgauged
#USD:modify for Third-party electricity meter by zhenglong.hong 20260411 end
